;;; org-setup-test.el --- Org directory setup tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(ert-deftest imoogi-org-setup-creates-directory-and-preserves-notes ()
  (let* ((home (make-temp-file "imoogi-org-home-" t))
         (notes (expand-file-name "notes/" home))
         (agenda (expand-file-name "agenda.org" notes))
         (org-directory "/previous/")
         (org-agenda-files nil)
         (expand (symbol-function 'expand-file-name)))
    (unwind-protect
        (cl-letf (((symbol-function 'expand-file-name)
                   (lambda (name &optional base)
                     (if (equal name "~/notes/") notes (funcall expand name base)))))
          (should (equal (imoogi-org-setup) notes))
          (should (file-directory-p notes))
          (should (file-directory-p (expand-file-name "permanent/" notes)))
          (should (file-exists-p agenda))
          (should (equal org-directory notes))
          (should (equal org-agenda-files (list notes)))
          (with-temp-file (concat notes "existing.org") (insert "* Keep me\n"))
          (with-temp-file agenda (insert "* Existing agenda\n"))
          (imoogi-org-setup)
          (should (equal (with-temp-buffer
                           (insert-file-contents agenda)
                           (buffer-string)) "* Existing agenda\n"))
          (should (equal (with-temp-buffer
                           (insert-file-contents (concat notes "existing.org"))
                           (buffer-string)) "* Keep me\n")))
      (delete-directory home t))))
(ert-deftest imoogi-org-setup-file-collision-preserves-setting ()
  (let* ((home (make-temp-file "imoogi-org-home-" t))
         (notes (expand-file-name "notes/" home))
         (org-directory "/previous/")
         (org-agenda-files nil)
         (expand (symbol-function 'expand-file-name)))
    (unwind-protect
        (progn
          (with-temp-file (directory-file-name notes) (insert "Keep"))
          (cl-letf (((symbol-function 'expand-file-name)
                     (lambda (name &optional base)
                       (if (equal name "~/notes/") notes (funcall expand name base)))))
            (should-error (imoogi-org-setup) :type 'file-error)
            (should (equal org-directory "/previous/"))
            (should-not org-agenda-files)))
      (delete-directory home t))))

(ert-deftest imoogi-org-setup-registers-notes-agenda-without-losing-existing-targets ()
  (let* ((home (make-temp-file "imoogi-org-home-" t))
         (old-directory (expand-file-name "old/" home))
         (notes (expand-file-name "notes/" home))
         (existing (expand-file-name "existing.org" old-directory))
         (nested (expand-file-name "nested/" notes))
         (org-directory old-directory)
         (org-agenda-files '("existing.org"))
         (expand (symbol-function 'expand-file-name)))
    (unwind-protect
        (progn
          (make-directory old-directory)
          (with-temp-file existing (insert "* Existing\n"))
          (cl-letf (((symbol-function 'expand-file-name)
                     (lambda (name &optional base)
                       (if (equal name "~/notes/") notes (funcall expand name base)))))
            (imoogi-org-setup)
            (with-temp-file (expand-file-name "daily.org" notes) (insert "* Daily\n"))
            (make-directory nested)
            (with-temp-file (expand-file-name "hidden.org" nested) (insert "* Hidden\n"))
            (let ((files (org-agenda-files)))
              (should (member existing files))
              (should (member (expand-file-name "agenda.org" notes) files))
              (should (member (expand-file-name "daily.org" notes) files))
              (should-not (member (expand-file-name "hidden.org" nested) files)))
            (should (equal org-agenda-files (list existing notes)))))
      (delete-directory home t))))

