(ert-deftest imoogi-treemacs-bookmark-rendering-creates-named-buttons ()
  (let ((bookmark-alist '(("Alpha" . ((filename . "/tmp/alpha.txt")))
                          ("Beta" . ((filename . "/tmp/beta.txt"))))))
    (with-temp-buffer
      (cl-letf (((symbol-function 'bookmark-maybe-load-default-file) #'ignore)
                ((symbol-function 'bookmark-location)
                 (lambda (bookmark)
                   (alist-get 'filename (cdr bookmark)))))
        (imoogi-treemacs--render-bookmarks (current-buffer) nil))
      (should (derived-mode-p 'imoogi-treemacs-tool-window-mode))
      (should (eq (lookup-key (current-local-map) (kbd "q"))
                  #'imoogi-treemacs-hide-tool-window))
      (should (eq (lookup-key (current-local-map) (kbd "g"))
                  #'imoogi-treemacs-refresh-bookmarks))
      (goto-char (point-min))
      (let ((alpha (button-at (point))))
        (should alpha)
        (should (equal (button-label alpha) "Alpha"))
        (should (equal (button-get alpha 'imoogi-bookmark-name) "Alpha"))
        (should (eq (button-get alpha 'action)
                    #'imoogi-treemacs--bookmark-button-action)))
      (should (search-forward "Beta" nil t))
      (let ((beta (button-at (match-beginning 0))))
        (should beta)
        (should (equal (button-label beta) "Beta"))
        (should (equal (button-get beta 'imoogi-bookmark-name) "Beta"))))))

(ert-deftest imoogi-treemacs-bookmark-button-action-jumps-in-editor-window ()
  (let ((editor-window (selected-window))
        (target-buffer (get-buffer-create " *imoogi-bookmark-target*"))
        (jumped-name nil))
    (unwind-protect
        (with-temp-buffer
          (insert-text-button
           "Alpha"
           'imoogi-bookmark-name "Alpha"
           'imoogi-editor-window editor-window
           'action #'imoogi-treemacs--bookmark-button-action)
          (goto-char (point-min))
          (cl-letf (((symbol-function 'bookmark-jump)
                     (lambda (name display-function)
                       (setq jumped-name name)
                       (funcall display-function target-buffer))))
            (push-button)
            (should (equal jumped-name "Alpha"))
            (should (eq (window-buffer editor-window) target-buffer))
            (should (eq (selected-window) editor-window))))
      (when (buffer-live-p target-buffer)
        (kill-buffer target-buffer)))))

(ert-deftest imoogi-treemacs-structure-rendering-preserves-nested-imenu-labels ()
  (let ((source-buffer (get-buffer-create " *imoogi-structure-source*")))
    (unwind-protect
        (with-temp-buffer
          (cl-letf (((symbol-function 'imenu--make-index-alist)
                     (lambda (&optional _noerror)
                       '(("*Rescan*" . ignore)
                         ("Classes"
                          ("Controller"
                           ("index" . 11)
                           ("show" . 22)))
                         ("top-level" . 33)))))
            (imoogi-treemacs--render-structure (current-buffer) source-buffer))
          (should (derived-mode-p 'imoogi-treemacs-tool-window-mode))
          (should (eq imoogi-treemacs--source-buffer source-buffer))
          (should (eq (lookup-key (current-local-map) (kbd "q"))
                      #'imoogi-treemacs-hide-tool-window))
          (should (eq (lookup-key (current-local-map) (kbd "g"))
                      #'imoogi-treemacs-refresh-structure))
          (should (string-match-p "Structure" header-line-format))
          (should (string-match-p "Classes" (buffer-string)))
          (should (string-match-p "Controller" (buffer-string)))
          (should (search-forward "index" nil t))
          (let ((index-button (button-at (match-beginning 0))))
            (should index-button)
            (should (equal (button-label index-button) "index"))
            (should (eq (button-get index-button 'imoogi-source-buffer)
                        source-buffer))
            (should (equal (button-get index-button 'imoogi-imenu-item)
                           '("index" . 11))))
          (should (search-forward "show" nil t))
          (should (button-at (match-beginning 0)))
          (should (search-forward "top-level" nil t))
          (should (button-at (match-beginning 0))))
      (when (buffer-live-p source-buffer)
        (kill-buffer source-buffer)))))

(ert-deftest imoogi-treemacs-structure-rendering-shows-empty-state ()
  (let ((source-buffer (get-buffer-create " *imoogi-empty-structure-source*")))
