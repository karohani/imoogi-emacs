(ert-deftest imoogi-treemacs-file-tree-closes-when-focused ()
  (let ((closed nil)
        (selected nil)
        (treemacs-window (selected-window)))
    (cl-letf (((symbol-function 'treemacs-get-local-window)
               (lambda () treemacs-window))
              ((symbol-function 'treemacs-quit)
               (lambda ()
                 (setq closed t)))
              ((symbol-function 'treemacs-select-window)
               (lambda (&optional _arg)
                 (setq selected t))))
      (imoogi-treemacs-toggle-file-tree)
      (should closed)
      (should-not selected))))

(ert-deftest imoogi-treemacs-file-tree-focuses-when-visible-from-editor ()
  (save-window-excursion
    (delete-other-windows)
    (let* ((editor-window (selected-window))
           (treemacs-window (split-window-right))
           (closed nil))
      (cl-letf (((symbol-function 'treemacs-get-local-window)
                 (lambda () treemacs-window))
                ((symbol-function 'treemacs-quit)
                 (lambda ()
                   (setq closed t)))
                ((symbol-function 'treemacs-select-window)
                 (lambda (&optional _arg)
                   (select-window treemacs-window))))
        (select-window editor-window)
        (imoogi-treemacs-toggle-file-tree)
        (should (eq (selected-window) treemacs-window))
        (should-not closed)))))

(ert-deftest imoogi-treemacs-file-tree-shows-when-absent ()
  (let ((hidden nil)
        (shown nil))
    (cl-letf (((symbol-function 'treemacs-get-local-window)
               (lambda () nil))
              ((symbol-function 'imoogi-treemacs-hide-tool-window)
               (lambda ()
                 (setq hidden t)))
              ((symbol-function 'treemacs-select-window)
               (lambda (&optional _arg)
                 (setq shown t))))
      (imoogi-treemacs-toggle-file-tree)
      (should hidden)
      (should shown))))

(ert-deftest imoogi-treemacs-bookmarks-hide-when-bookmarks-visible ()
  (let ((bookmarks-window (selected-window))
        (deleted-window nil)
        (hidden nil)
        (rendered nil)
        (displayed nil))
    (cl-letf (((symbol-function 'imoogi-treemacs--custom-tool-window)
               (lambda (kind)
                 (and (eq kind 'bookmarks) bookmarks-window)))
              ((symbol-function 'delete-window)
               (lambda (window)
                 (setq deleted-window window)))
              ((symbol-function 'imoogi-treemacs-hide-tool-window)
               (lambda ()
                 (setq hidden t)))
              ((symbol-function 'imoogi-treemacs--render-bookmarks)
               (lambda (&rest _)
                 (setq rendered t)))
              ((symbol-function 'imoogi-treemacs--display-tool-buffer)
               (lambda (&rest _)
                 (setq displayed t))))
      (imoogi-treemacs-toggle-bookmarks)
      (should (eq deleted-window bookmarks-window))
      (should-not hidden)
      (should-not rendered)
      (should-not displayed))))

(ert-deftest imoogi-treemacs-bookmarks-switches-from-another-tool-window ()
  (let ((hidden nil)
        (rendered nil)
        (displayed nil)
        (source-buffer (current-buffer))
        (display-kind nil))
    (cl-letf (((symbol-function 'imoogi-treemacs--custom-tool-window)
               (lambda (_kind) nil))
              ((symbol-function 'imoogi-treemacs--editor-buffer)
               (lambda () source-buffer))
              ((symbol-function 'imoogi-treemacs-hide-tool-window)
               (lambda ()
                 (setq hidden t)))
              ((symbol-function 'imoogi-treemacs--render-bookmarks)
               (lambda (_buffer seen-source-buffer)
                 (setq rendered seen-source-buffer)))
              ((symbol-function 'imoogi-treemacs--display-tool-buffer)
               (lambda (_buffer kind)
                 (setq displayed t
                       display-kind kind))))
      (imoogi-treemacs-toggle-bookmarks)
      (should hidden)
      (should (eq rendered source-buffer))
      (should displayed)
      (should (eq display-kind 'bookmarks)))))

