                       '(nil ("*Rescan*" . -99)))))
            (imoogi-treemacs--render-structure (current-buffer) source-buffer))
          (should (string-match-p "Structure 정보가 없습니다" (buffer-string))))
      (when (buffer-live-p source-buffer)
        (kill-buffer source-buffer)))))

(ert-deftest imoogi-treemacs-custom-window-ignores-a-reused-stale-slot ()
  (let ((bookmarks-buffer
         (get-buffer-create imoogi-treemacs-bookmarks-buffer-name))
        (replacement-buffer (get-buffer-create " *imoogi-reused-tool-slot*")))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (let ((window
                 (display-buffer-in-side-window
                  bookmarks-buffer
                  '((side . left)
                    (slot . -1)
                    (window-parameters
                     . ((imoogi-treemacs-tool-window . bookmarks)))))))
            (should (eq (imoogi-treemacs--custom-tool-window 'bookmarks) window))
            (set-window-buffer window replacement-buffer)
            (should-not (imoogi-treemacs--custom-tool-window 'bookmarks))))
      (dolist (buffer (list bookmarks-buffer replacement-buffer))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

(ert-deftest imoogi-treemacs-structure-button-action-uses-source-buffer-and-imenu ()
  (let ((source-buffer (get-buffer-create " *imoogi-structure-action-source*"))
        (editor-window (selected-window))
        (seen-item nil)
        (recentered nil))
    (unwind-protect
        (with-temp-buffer
          (insert-text-button
           "index"
           'imoogi-source-buffer source-buffer
           'imoogi-editor-window editor-window
           'imoogi-imenu-item '("index" . 11)
           'action #'imoogi-treemacs--structure-button-action)
          (goto-char (point-min))
          (cl-letf (((symbol-function 'imenu)
                     (lambda (item)
                       (setq seen-item item)))
                    ((symbol-function 'recenter)
                     (lambda (&optional _arg)
                       (setq recentered t))))
            (push-button)
            (should (eq (selected-window) editor-window))
            (should (eq (current-buffer) source-buffer))
            (should (equal seen-item '("index" . 11)))
            (should recentered)))
      (when (buffer-live-p source-buffer)
        (kill-buffer source-buffer)))))

(ert-deftest imoogi-treemacs-tool-windows-share-one-left-side-slot ()
  (let ((source-buffer (get-buffer-create " *imoogi-tool-window-source*"))
        (bookmark-alist nil))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (set-window-buffer (selected-window) source-buffer)
          (with-current-buffer source-buffer
            (emacs-lisp-mode)
            (erase-buffer)
            (insert "(defun alpha () nil)\n"))
          (cl-letf (((symbol-function 'bookmark-maybe-load-default-file)
                     #'ignore))
            (imoogi-treemacs-toggle-bookmarks))
          (should (imoogi-treemacs--custom-tool-window 'bookmarks))

          (imoogi-treemacs-toggle-structure)
          (should-not (imoogi-treemacs--custom-tool-window 'bookmarks))
          (should (imoogi-treemacs--custom-tool-window 'structure))
          (with-current-buffer imoogi-treemacs-structure-buffer-name
            (should (string-match-p "alpha" (buffer-string))))

          (imoogi-treemacs-toggle-structure)
          (should-not (imoogi-treemacs--custom-tool-window 'structure)))
      (dolist (buffer (list source-buffer
                            (get-buffer imoogi-treemacs-bookmarks-buffer-name)
                            (get-buffer imoogi-treemacs-structure-buffer-name)))
        (when (buffer-live-p buffer)
          (kill-buffer buffer))))))

