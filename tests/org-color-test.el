;;; org-color-test.el --- Colored text tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)

(ert-deftest imoogi-org-color-interactive-picker ()
  "Exercise the real color picker, including candidate face construction."
  (with-temp-buffer
    (org-mode)
    (insert "문장")
    (goto-char (point-min))
    (push-mark (point-max) t t)
    (let ((transient-mark-mode t))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (&rest _) "red")))
        (call-interactively #'imoogi-org-color-apply)))
    (should (equal (buffer-string) "[[color:red][문장]]"))))

(ert-deftest imoogi-org-color-insert-and-render ()
  (with-temp-buffer
    (org-mode)
    (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "새 문장")))
      (imoogi-org-color-apply "red"))
    (should (equal (buffer-string) "[[color:red][새 문장]]"))
    (font-lock-ensure)
    (search-backward "새 문장")
    (should (equal (get-text-property (point) 'face) '(:foreground "red")))))

(ert-deftest imoogi-org-color-region-change-remove ()
  (with-temp-buffer
    (org-mode)
    (insert "문장 뒤")
    (goto-char 1)
    (push-mark 3 t t)
    (let ((transient-mark-mode t)) (imoogi-org-color-apply "red"))
    (should (equal (buffer-string) "[[color:red][문장]] 뒤"))
    (goto-char 15)
    (imoogi-org-color-apply "#3498db")
    (should (equal (buffer-string) "[[color:#3498db][문장]] 뒤"))
    (goto-char 18)
    (imoogi-org-color-remove)
    (should (equal (buffer-string) "문장 뒤"))))

(ert-deftest imoogi-org-color-invalid-selection-is-unchanged ()
  (with-temp-buffer
    (org-mode)
    (insert "[[https://example.com][문장]]")
    (let ((before (buffer-string)) (transient-mark-mode t))
      (goto-char (point-min))
      (push-mark (point-max) t t)
      (should-error (imoogi-org-color-apply "red") :type 'user-error)
      (should (equal before (buffer-string)))
      (should-error (imoogi-org-color-apply "not-a-real-color") :type 'user-error)
      (should (equal before (buffer-string))))))

(ert-deftest imoogi-org-color-face-and-menu ()
  (should (equal (imoogi-org-color--face "red") '(:foreground "red")))
  (should (eq (imoogi-org-color--face "not-a-real-color") 'org-link))
  (should (eq (org-link-get-parameter "color" :face) #'imoogi-org-color--face))
  (should (transient-get-suffix 'imoogi-org-agenda-transient "C"))
  (should (transient-get-suffix 'imoogi-org-color-transient "c"))
  (should (transient-get-suffix 'imoogi-org-color-transient "r")))

(ert-deftest imoogi-org-color-hex-is-display-independent ()
  (should (equal (imoogi-org-color-hex "blue1") "#0000ff"))
  (should (equal (imoogi-org-color-hex "#3498db") "#3498db"))
  (should (equal (imoogi-org-color-hex "LightBlue") (imoogi-org-color-hex "lightblue")))
  (should (equal (imoogi-org-color-hex "light blue") (imoogi-org-color-hex "lightblue")))
  (should (equal (imoogi-org-color-hex "Red") "#ff0000"))
  (should-not (imoogi-org-color-hex "not-a-real-color")))

(ert-deftest imoogi-org-color-html-export-applies-color ()
  (require 'ox-html)
  (let ((html (org-export-string-as "[[color:blue1][파란 글]] [[color:#3498db][hex]]" 'html t)))
    (should (string-match-p "<span style=\"color:#0000ff\">파란 글</span>" html))
    (should (string-match-p "<span style=\"color:#3498db\">hex</span>" html))
    (should-not (string-match-p "color:blue1\\|href=\"color" html))))

(ert-deftest imoogi-org-color-invalid-export-keeps-text ()
  (require 'ox-html)
  (let ((html (org-export-string-as "[[color:not-a-real-color][글]]" 'html t)))
    (should (string-match-p "글" html))
    (should-not (string-match-p "style=\\|href=" html))))

(ert-deftest imoogi-org-color-preview-payload-maps-names ()
  (with-temp-buffer
    (org-mode)
    (insert "[[color:blue1][a]] [[color:#3498db][b]] [[color:nope][c]]")
    (let ((colors (alist-get 'color_map (imoogi-org-preview--build-update-payload))))
      (should (equal (cdr (assoc "blue1" colors)) "#0000ff"))
      (should (equal (cdr (assoc "#3498db" colors)) "#3498db"))
      (should-not (assoc "nope" colors)))))

(ert-deftest imoogi-org-color-undescribed-export-is-escaped ()
  (require 'ox-html)
  (let ((html (org-export-string-as "[[color:<img src=x onerror=alert(1)>]]" 'html t)))
    (should-not (string-match-p "<img" html))
    (should (string-match-p "&lt;img" html))))
