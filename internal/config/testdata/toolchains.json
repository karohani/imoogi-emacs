{
  "schema": "imoogi-toolchains-desired/v1",
  "cli_version": "1.2.3",
  "bundle": "2026.08.15.1",
  "target": {
    "os": "darwin",
    "arch": "arm64"
  },
  "components": [
    {
      "name": "gopls",
      "kind": "go-language-server",
      "source": "golang.org/x/tools/gopls",
      "upstream_version": "v0.20.0"
    },
    {
      "name": "node",
      "kind": "node-runtime",
      "source": "nodejs.org/dist",
      "upstream_version": "v22.14.0"
    },
    {
      "name": "typescript",
      "kind": "typescript-sdk",
      "source": "npm:typescript",
      "upstream_version": "5.8.2"
    },
    {
      "name": "typescript-language-server",
      "kind": "typescript-language-server",
      "source": "npm:typescript-language-server",
      "upstream_version": "4.3.3",
      "runtime": {
        "node_engine": ">=20.0.0 <23.0.0"
      }
    }
  ],
  "runtime_policy": {
    "node_version": "22.14.0"
  }
}
