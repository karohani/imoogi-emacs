{
  "schema": "imoogi-vendor-index/v1",
  "boundaries": [
    "assets",
    "vendor"
  ],
  "roots": [
    "assets/fonts",
    "packages.el",
    "packages.lock",
    "provenance/sources.json",
    "toolchains.json",
    "toolchains.lock.json",
    "vendor/elpa",
    "vendor/ghostel-module",
    "vendor/toolchains",
    "vendor/tree-sitter"
  ],
  "manifests": [
    "provenance/elpa.json",
    "provenance/fonts.json",
    "provenance/ghostel.json",
    "provenance/metadata.json",
    "provenance/toolchains.json",
    "provenance/tree-sitter.json"
  ],
  "excludes": [
    {
      "path": "vendor/tree-sitter/README.md",
      "reason": "repository documentation; not an external grammar artifact"
    }
  ]
}
